# CleverCoder — Environment Variables

# ─── Core ────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
PUBLIC_URL=http://localhost:8080

# ─── Security ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=supersecret_change_me_in_production_min32chars!
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d
ENCRYPTION_KEY=supersecret_encryption_key_min32chars!

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clevercoder

# ─── Cellar S3 ───────────────────────────────────────────────
# For local dev: use MinIO (docker-compose.dev.yml)
CELLAR_ADDON_HOST=localhost:9000
CELLAR_ADDON_KEY_ID=minioadmin
CELLAR_ADDON_KEY_SECRET=minioadmin
CELLAR_BUCKET=clever-coder
CELLAR_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ─── Sync Tuning ─────────────────────────────────────────────
SYNC_INTERVAL_MS=15000
SYNC_DEBOUNCE_MS=3000
IDLE_IDE_TIMEOUT_MIN=20
WORKSPACES_ROOT=/workspaces

# ─── GitHub OAuth (optional) ─────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback

# ─── AI (optional) ───────────────────────────────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Hermes AI Agent ─────────────────────────────────────────
# Master encryption key for storing provider API keys in DB
# Falls back to ENCRYPTION_KEY if not set
# HERMES_ENCRYPTION_SECRET=32_byte_hex_string_here

# S3 artifact prefix (uses existing CELLAR_* bucket)
HERMES_S3_PREFIX=hermes

# Large payload threshold in bytes (default 10240 = 10 KB)
HERMES_S3_THRESHOLD_BYTES=10240
